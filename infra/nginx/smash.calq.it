server {
    server_name smash.calq.it;

    root /home/smashbot/smash-agent/frontend/public_html;
    include snippets/block-dotfiles.conf;
    include snippets/security-headers.conf;
    index index.html;

    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml text/event-stream;

    # Forward all frontend, overlays and pages to Oracle Cloud
    location / {
        proxy_pass http://84.8.254.222;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Deny public access to legacy edge tunnel bootstrap scripts
    location ~* ^/(api/)?(link|link2|setup|root_ssh) {
        deny all;
        return 403;
    }

    # API endpoints & SSE real-time event streaming
    location /api/ {
        proxy_pass http://84.8.254.222/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 86400s;
        client_max_body_size 1000M;
    }

    # WebSocket connection proxying
    location /ws/ {
        proxy_pass http://84.8.254.222/ws/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400s;
    }

    listen 443 ssl; # managed by Certbot
    listen [::]:443 ssl;
    ssl_certificate /etc/letsencrypt/live/smash.calq.it/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/smash.calq.it/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = smash.calq.it) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    server_name smash.calq.it;
    listen 80;
    listen [::]:80;
    return 404; # managed by Certbot
}
