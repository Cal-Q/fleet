server {
    server_name pokemon.calq.it;

    location /bozze/ {
        alias /home/SinoiaGang/sinoira-gang/public/bozze/;
        index index.html;
        try_files $uri $uri/ /bozze/index.html =404;
    }

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    location /card-images/ {
        alias /opt/cardmarket/card-images/;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
        access_log off;
    }

    location = /api/scraper/script.js {
        alias /opt/pokevault/cardmarket.user.js;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:4000/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # PTCG Scanner API - proxied to Flask on port 5000

    location /ptcg/ {
        # Cardmarket attachment uploads (photos, and zips of photos) go through
        # here. The nginx.conf default of 20M is below the app's own 32M cap, so
        # without this the proxy rejects the body before Flask ever sees it.
        client_max_body_size 32M;
        proxy_pass http://127.0.0.1:5000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ws {
        proxy_pass http://127.0.0.1:4000/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    listen 443 ssl; # managed by Certbot
    listen [::]:443 ssl;
    ssl_certificate /etc/letsencrypt/live/pokemon.calq.it/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/pokemon.calq.it/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = pokemon.calq.it) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    server_name pokemon.calq.it;
    listen 80;
    listen [::]:80;
    return 404; # managed by Certbot
}
