server {
    server_name calq.it www.calq.it;
    client_max_body_size 1000M;
    root /var/www/calq;
    index index.html;

    include snippets/block-dotfiles.conf;
    include snippets/security-headers.conf;

    location = /transcripts/review {
        return 301 https://$host/to-do;
    }

    location = /transcripts/review.html {
        return 301 https://$host/to-do;
    }

    location = /transcripts {
        return 301 https://$host/transcripts/;
    }

    location /transcripts/ {
        auth_request /internal_hub_auth;
        error_page 401 =302 https://$host/console/;
        error_page 403 =302 https://$host/console/;

        proxy_pass http://127.0.0.1:8877/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Accept-Encoding "";
        proxy_buffering off;
        proxy_cache off;
        client_max_body_size 2000M;
    }

    
    location = /internal_hub_auth {
        internal;
        proxy_pass http://127.0.0.1:4201/api/auth_check;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header Cookie $http_cookie;
    }

    location /console/ttyd/ {
        auth_basic off;
        auth_request /internal_hub_auth;
        error_page 401 =302 https://$host/console/;
        error_page 403 =302 https://$host/console/;
        proxy_pass http://127.0.0.1:7681;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Accept-Encoding "";
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_socket_keepalive on;
        keepalive_timeout 86400s;
        proxy_buffering off;
        proxy_cache off;
        tcp_nodelay on;

        sub_filter "</head>" "<style>::-webkit-scrollbar,.xterm-viewport::-webkit-scrollbar{width:16px !important;height:16px !important;}::-webkit-scrollbar-track,.xterm-viewport::-webkit-scrollbar-track{background:#11151c !important;}::-webkit-scrollbar-thumb,.xterm-viewport::-webkit-scrollbar-thumb{background:#586069 !important;border-radius:8px !important;border:3px solid #11151c !important;}::-webkit-scrollbar-thumb:hover,.xterm-viewport::-webkit-scrollbar-thumb:hover{background:#8b949e !important;}.xterm-viewport{scrollbar-width:auto !important;scrollbar-color:#586069 #11151c !important;}</style></head>";
        sub_filter_once on;
    }

    location = /console {
        return 301 https://$host/console/;
    }

    location /console/ {
        proxy_read_timeout 300s;
        proxy_connect_timeout 300s;
        proxy_send_timeout 300s;
        auth_basic off;
        proxy_pass http://127.0.0.1:4201/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Accept-Encoding "";
        proxy_buffering off;
        proxy_cache off;
        client_max_body_size 2000M;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:4201/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Accept-Encoding "";
        proxy_buffering off;
        proxy_cache off;
    }

    location = /thoughts {
        return 301 https://$host/thoughts/;
    }

    location = /flying-thoughts {
        return 301 https://$host/thoughts/;
    }

    location = /flying-thoughts/ {
        return 301 https://$host/thoughts/;
    }

    location /thoughts/ {
        auth_basic off;
        proxy_pass http://127.0.0.1:3040/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
    }

    location = /unito {
        return 301 https://$host/unito/;
    }

    location /unito/api/telemetry/ {
        auth_basic off;
        limit_req zone=unito_telemetry_limit burst=5 nodelay;
        client_max_body_size 64k;
        proxy_pass http://127.0.0.1:8765/api/telemetry/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
    }

    location /unito/ {
        auth_basic off;
        add_header Cache-Control "no-cache, must-revalidate, max-age=0" always;
        try_files $uri $uri/ /unito/index.html;
    }


    location = /security {
        return 301 https://$host/security/;
    }

    location ^~ /security/css/ {
        proxy_pass http://84.8.254.222/security/css/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /security/js/ {
        proxy_pass http://84.8.254.222/security/js/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /security/ {
        auth_request /internal_hub_auth;
        error_page 401 =302 https://$host/console/;
        error_page 403 =302 https://$host/console/;

        proxy_pass http://84.8.254.222/security/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /fitness {
        return 301 https://$host/fitness/;
    }

    location ^~ /fitness/css/ {
        proxy_pass http://84.8.254.222/fitness/css/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /fitness/js/ {
        proxy_pass http://84.8.254.222/fitness/js/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /fitness/assets/ {
        proxy_pass http://84.8.254.222/fitness/assets/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /fitness/ {
        auth_request /internal_hub_auth;
        error_page 401 =302 https://$host/console/;
        error_page 403 =302 https://$host/console/;

        proxy_pass http://84.8.254.222/fitness/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /to-do/ {
        alias /var/www/calq/;
        index index.html;
    }

    location = /to-do {
        return 301 https://$host/to-do/;
    }

    location = / {
        return 302 https://$host/thoughts/;
    }

    location / {
        auth_basic off;
        try_files $uri $uri/ /index.html;
    }

    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/calq.it/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/calq.it/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = www.calq.it) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    if ($host = calq.it) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    listen [::]:80;
    server_name calq.it www.calq.it;
    client_max_body_size 1000M;
    return 404; # managed by Certbot
}
