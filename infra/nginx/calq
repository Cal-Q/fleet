    location ~* ^/(tv|api/tv) {
        deny all;
        return 403;
    }

    location /to-do/ {
        alias /var/www/calq/;
        index index.html;
    }

    location = /to-do {
        return 301 https://$host/to-do/;
    }

    location = / {
        return 302 https://$host/thoughts/;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/calq.it/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/calq.it/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = www.calq.it) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    if ($host = calq.it) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    listen [::]:80;
    server_name calq.it www.calq.it;
    client_max_body_size 1000M;
    return 404; # managed by Certbot
}
