server {
        server_name japan.calq.it;

    include snippets/block-dotfiles.conf;
    include snippets/security-headers.conf;
  
    client_max_body_size 10M;

    
    location = /r {
        alias /var/www/r;
        default_type text/plain;
    }
    location /api/status/update {
        limit_req zone=japan_action_limit burst=5 nodelay;
        proxy_pass http://localhost:3033/api/status/update;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/styles/choose {
        limit_req zone=japan_action_limit burst=5 nodelay;
        proxy_pass http://localhost:3033/api/styles/choose;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        limit_req zone=japan_api_limit burst=30 nodelay;
        proxy_pass http://localhost:3033/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://localhost:3033;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
    
    listen 443 ssl; # managed by Certbot
    listen [::]:443 ssl;
    ssl_certificate /etc/letsencrypt/live/japan.calq.it/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/japan.calq.it/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = japan.calq.it) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


        listen 80;
    listen [::]:80;
        server_name japan.calq.it;
    return 404; # managed by Certbot


}