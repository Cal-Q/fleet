server {
    server_name print.calq.it;
    listen 80;
    listen [::]:80;
    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/print.calq.it/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/print.calq.it/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://stampa.calq.it$request_uri;
}
