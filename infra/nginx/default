        async function submitDonationText() {
            const input = document.getElementById('donate-text-input').value;
            const btn = document.getElementById('btn-donate-text');
            const rawLines = input.split('\n').map(l => l.trim()).filter(l => l.length > 5);

            if (rawLines.length === 0) return AppCore.ui.showToast("Please enter at least one valid code.", "error");

            btn.disabled = true;
            btn.innerHTML = `<i data-lucide="loader" class="animate-spin"></i> Processing...`;
            lucide.createIcons();

            try {
                const cols = Math.min(3, rawLines.length);
                const rows = Math.ceil(rawLines.length / cols);
                const qrSize = 150;
                const padding = 20;
                const textHeight = 30;

                const canvas = document.createElement('canvas');
                canvas.width = cols * (qrSize + padding) + padding;
                canvas.height = rows * (qrSize + textHeight + padding) + padding;
                const ctx = canvas.getContext('2d');
                ctx.fillStyle = '#ffffff';
                ctx.fillRect(0, 0, canvas.width, canvas.height);

                for (let i = 0; i < rawLines.length; i++) {
                    const code = rawLines[i];
                    const col = i % cols;
                    const row = Math.floor(i / cols);
                    const x = padding + col * (qrSize + padding);
                    const y = padding + row * (qrSize + textHeight + padding);

                    const qr = new QRious({ value: code, size: qrSize, level: 'H' });
                    const img = new Image();
                    img.src = qr.toDataURL();
                    await new Promise(r => { img.onload = r; });
                    ctx.drawImage(img, x, y);

                    ctx.fillStyle = '#000000';
                    ctx.font = '16px monospace';
                    ctx.textAlign = 'center';
                    ctx.fillText(code, x + (qrSize / 2), y + qrSize + 22);
                }

                canvas.toBlob(blob => {
                    const formData = new FormData();
                    formData.append('image', blob, `qr_donation_${Date.now()}.png`);
                    uploadDonationFormData(formData);
                }, 'image/png');

            } catch (e) {
                AppCore.ui.showToast("Failed to generate QR codes.", "error");
                btn.disabled = false;
                btn.innerHTML = `<i data-lucide="qr-code"></i> Generate & Upload`;
                lucide.createIcons();
            }
        }

        function submitDonationImage() {
            const input = document.getElementById('donate-file-input');
            const btn = document.getElementById('btn-donate-img');

            if (!input.files || input.files.length === 0) return;

            const file = input.files[0];

            btn.disabled = true;
            btn.innerHTML = `<i data-lucide="loader" class="animate-spin w-8 h-8"></i> Uploading...`;
            if (window.lucide) lucide.createIcons();

            const formData = new FormData();
            formData.append('image', file);

            fetch('/api/community/donate', {
                method: 'POST',
                headers: { 'Authorization': `Bearer ${webToken}` },
                body: formData
            })
            .then(async res => {
                const data = await res.json();
                if (data.status === "success") {
                    closeModal();
                    triggerSuccessAnimation(t('donationThanks'), () => loadLeaderboard());
                } else {
                    throw new Error(data.error || "Upload failed");
                }
            })
            .catch(err => {
                AppCore.ui.showToast(err.message, "error");
                resetUploadButton();
            });
        }

