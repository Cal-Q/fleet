function submitVoucher() {
    const codeInput = document.getElementById('voucher-input');
    const btn = document.getElementById('btn-submit-voucher');
    const code = codeInput.value.trim();
    
    if (!code) return;

    // Disable button to prevent spamming while request is flying
    btn.disabled = true;
    btn.innerHTML = `<i data-lucide="loader" class="animate-spin w-5 h-5 mx-auto"></i>`;
    if (window.lucide) lucide.createIcons();

    fetch('/api/redeem', { method: 'POST', headers: getAuthHeaders(), body: JSON.stringify({ code: code }) })
        .then(res => res.json())
        .then(async data => {
            btn.disabled = false;
            btn.innerHTML = t('redeem');

            if (data.status === "success") {
                AppCore.ui.showToast(`${t('redeemed')}${data.amount.toFixed(2)}`, 'success');
                closeModal(); 
                await loadUserData();
            } else {
                AppCore.ui.showToast(data.message || t('invalidVoucher'), "error");
                codeInput.value = ''; // Clear input field for convenience
                
                // 1. Fetch fresh data to get the updated strike count from the DB
                await loadUserData(); 
                
                // 2. Update the warning text in the DOM
                let newStrikes = currentUserData && currentUserData.voucher_strikes ? currentUserData.voucher_strikes : 0;
                let newAttemptsLeft = 5 - newStrikes;
                let attemptsSpan = document.getElementById('attempts-left-count');
                
                if (attemptsSpan) {
                    attemptsSpan.innerText = newAttemptsLeft;
                    
                    // Flash the number black/white briefly to draw the user's attention to the decrease
                    attemptsSpan.classList.add('text-gray-900', 'dark:text-white', 'text-base');
                    setTimeout(() => attemptsSpan.classList.remove('text-gray-900', 'dark:text-white', 'text-base'), 500);
                }
                
                // 3. Force close the modal if they just hit the 5th strike
                if (newStrikes >= 5) {
                    closeModal(); 
                }
            }
        }).catch(() => {
            btn.disabled = false;
            btn.innerHTML = t('redeem');
            AppCore.ui.showToast(t('networkError'), "error");
        });
}
