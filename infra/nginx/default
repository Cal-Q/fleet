        // THE ONLY SAFE DEFINITION OF triggerSuccessAnimation
        function triggerSuccessAnimation(subtext = "Processing...", callback = null) {
            const overlay = document.getElementById('success-overlay');
            const check = document.getElementById('success-check');
            const textEl = document.getElementById('success-subtext');

            if (textEl) textEl.innerText = subtext;

            overlay.classList.remove('hidden'); 
            overlay.classList.add('flex');

            requestAnimationFrame(() => {
                overlay.classList.remove('opacity-0');
                check.classList.add('animate-bounce-check');
                if (window.tg && tg.HapticFeedback) tg.HapticFeedback.notificationOccurred('success');
            });

            setTimeout(() => {
                overlay.classList.add('opacity-0');
                setTimeout(() => { 
                    overlay.classList.add('hidden'); 
                    overlay.classList.remove('flex'); 
                    if (typeof callback === 'function') callback(); 
                }, 300);
            }, 2000);
        }

        // --- Entry Point ---
        async function startApp() {
            AppCore.init();
            changeLanguage(currentLang);
            updateSettings();
            
            if (window.tg) { tg.ready(); tg.expand(); }
            
            if (typeof tg === 'undefined' || tg.platform === 'unknown' || !tg.initData) initWebMode();
            else { 
                let checkCount = 0; 
                while (!tg.initData && checkCount < 40) { await new Promise(r => setTimeout(r, 100)); checkCount++; } 
                initSessionTimer(); 
                determineInitialState();
            }
            
            await loadUserData(); 
            await loadCatalog();
        }

        document.addEventListener('DOMContentLoaded', startApp);

    </script>
    
