async function loadUserData() {
    tg.ready(); tg.expand();
    const urlParams = new URLSearchParams(window.location.search);

    if (isWebMode && webUser) currentUserDisplayName = webUser.first_name;
    else if (urlParams.get('name')) currentUserDisplayName = decodeURIComponent(urlParams.get('name'));
    else if (tg.initDataUnsafe?.user) currentUserDisplayName = tg.initDataUnsafe.user.first_name;

    updateAuthUI();

    if (urlParams.has('balance')) {
        userBalance = parseFloat(urlParams.get('balance')) || 0.00;
        document.getElementById('user-balance').innerText = userBalance.toFixed(2);
    }

    let retries = 0;
    while (!tg.initData && !isWebMode && retries < 7) { await new Promise(r => setTimeout(r, 100)); retries++; }

    if (tg.initData || isWebMode) {
        try {
            // Add a timestamp to the URL to force a fresh request (cache busting)
            const response = await fetch(`${API_BASE}/get_user_data?cb=${Date.now()}`, { 
                headers: getAuthHeaders(),
                cache: 'no-store' 
            });
            if (response.ok) {
                currentUserData = await response.json(); 
                userBalance = parseFloat(currentUserData.balance) || 0.00;
                document.getElementById('user-balance').innerText = userBalance.toFixed(2);
            }
        } catch (e) { console.warn("Failed user fetch", e); }
    }
}

