    function submitOrder() {
        if (isWebMode && !webUser) return AppCore.ui.showToast(t('googleLoginReq'), "error");

        const payBtn = document.getElementById('btn-pay');
        payBtn.disabled = true; payBtn.innerText = t('processing');

        let out = {};
        let totalCost = 0;
        for (let [id, q] of Object.entries(cart)) {
            if (q > 0) {
                out[id] = q;
                let item = findItemInCatalog(id);
                if (item) totalCost += q * parseFloat(item.price);
            }
        }
        let oldBalance = userBalance;

        fetch(`${API_BASE}/checkout`, {
            method: 'POST',
            headers: getAuthHeaders(),
            body: JSON.stringify({ action: "checkout", cart: out })
        })
        .then(res => res.json())
        .then(data => {
            if (data.status === "success") {
                cart = {}; initialCartState = {};
                renderStore(); updateCheckoutUI();
                if (isWebMode) showWebReceipt(data.receipt, oldBalance, totalCost);
                else triggerSuccessAnimation(t('orderConfirmed'), () => tg.close());
            } else {
                AppCore.ui.showToast(data.error || t('checkoutFailed'), "error");
                closeModal(); loadCatalog();
            }
        })
        .catch(err => {
            AppCore.ui.showToast(t('netErrorVault'), "error");
            payBtn.disabled = false; payBtn.innerText = t("confirmPay");
        });
    }

    function showWebReceipt(receiptData, oldBalance = 0, totalCost = 0) {
        let newBalance = oldBalance - totalCost;
        let html = `<h3 class="text-2xl font-extrabold mb-4 text-success flex items-center gap-2"><i data-lucide="check-circle"></i> ${t('orderConfirmed')}</h3>
        
        <div class="bg-surface-50 dark:bg-gray-900 p-4 rounded-xl mb-4 font-semibold text-sm">
            <div class="flex justify-between text-gray-500 dark:text-gray-400"><span>Previous Balance</span><span>€${oldBalance.toFixed(2)}</span></div>
            <div class="flex justify-between text-danger"><span>Order Total</span><span>-€${totalCost.toFixed(2)}</span></div>
            <div class="flex justify-between pt-2 mt-2 border-t border-gray-200 dark:border-gray-700 text-gray-900 dark:text-white font-extrabold text-lg"><span>New Balance</span><span>€${newBalance.toFixed(2)}</span></div>
        </div>
        
        <div class="bg-surface-50 dark:bg-gray-900 p-4 rounded-xl mb-6 max-h-[40vh] overflow-y-auto text-sm space-y-4">`;
        
        let codeCount = 0;
        for (let prod in receiptData) {
            html += `<div><b class="text-brand-600 dark:text-brand-400 block mb-1">${escapeHTML(t(prod))}</b>`;
            receiptData[prod].forEach(code => {
                if (codeCount < 10) html += `<code class="bg-gray-200 dark:bg-gray-800 px-2 py-1 rounded block mb-1 font-mono">${escapeHTML(code)}</code>`;
