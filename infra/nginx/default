// Disconnect function
function disconnectPlatform(platform) {
    if(!confirm(`Are you sure you want to disconnect ${platform}?`)) return;
    fetch(`/api/auth/disconnect/${platform}`, { method: 'POST', headers: getAuthHeaders() })
    .then(res => res.json())
    .then(async data => {
        if(data.status === 'success') {
            AppCore.ui.showToast(`Disconnected ${platform}`, 'success');
            await loadUserData();
            openCommunitySettingsModal(); // Refresh modal
        }
    });
}
function saveCommunitySettings() {
    const showLb = document.getElementById('pref-show-lb').checked ? 1 : 0;
    const namePref = document.getElementById('pref-name').value;
    
    // Safely check Twitch toggles
    const twitchCb = document.getElementById('pref-show-twitch');
    const showTwitch = (twitchCb && twitchCb.checked) ? 1 : 0;
    const twitchLiveCb = document.getElementById('pref-show-twitch-live');
    const showTwitchLive = (twitchLiveCb && twitchLiveCb.checked) ? 1 : 0;

    // Safely check YouTube toggles
    const ytCb = document.getElementById('pref-show-yt');
    const showYt = (ytCb && ytCb.checked) ? 1 : 0;
    const ytLiveCb = document.getElementById('pref-show-yt-live');
    const showYtLive = (ytLiveCb && ytLiveCb.checked) ? 1 : 0;

    fetch('/api/community/settings/prefs', {
        method: 'POST',
        headers: getAuthHeaders(),
        body: JSON.stringify({
            show_on_leaderboard: showLb,
            name_pref: namePref,
            show_twitch: showTwitch,
            show_twitch_live: showTwitchLive,
            show_youtube: showYt,
            show_youtube_live: showYtLive
        })
    })
    .then(res => res.json())
    .then(async (data) => {
        if(data.status === "success") {
            AppCore.ui.showToast("Settings updated!", "success");
            closeModal();
            
            // Force a fresh data reload so UI updates
            await loadUserData(); 
            await loadLeaderboard(); 
        } else {
            AppCore.ui.showToast(data.error || "Failed to save", "error");
        }
    })
    .catch(() => AppCore.ui.showToast("Network error", "error"));
}

// Helper function to safely send tokens via POST instead of URL parameters
function createAuthForm(actionUrl) {
    const form = document.createElement('form');
    form.method = 'POST';
    form.action = actionUrl;
    
    const input = document.createElement('input');
    input.type = 'hidden';
    
    if (isWebMode && webToken) {
        input.name = 'web_token';
        input.value = webToken;
    } else if (window.tg && tg.initData) {
        input.name = 'tg_data';
        input.value = tg.initData;
    } else {
        return null; // Auth missing
    }
    
    form.appendChild(input);
    document.body.appendChild(form);
    return form;
}

