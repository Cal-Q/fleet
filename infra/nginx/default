        // --- Interaction & Cart ---
        function updateQty(id, change, max) {
            let current = cart[id] || 0;
            const cleanId = String(id).replace(/\W/g, '');

            if (current >= max && change > 0) {
                AppCore.ui.showToast(t('limitReached'), 'error');
                return;
            }

            let next = Math.max(0, Math.min(current + change, max));
            cart[id] = next;

            const input = document.getElementById(`qty-${cleanId}`);
            if (input) input.value = next;

            const fillBar = document.getElementById(`stock-fill-${cleanId}`);
            const textBar = document.getElementById(`stock-text-${cleanId}`);

            if (fillBar && textBar) {
                fillBar.style.width = `${(next / max) * 100}%`;
                textBar.innerText = `${next}/${max}`;
                if (next === max) { fillBar.className = `h-full transition-all duration-300 bg-success`; }
                else { fillBar.className = `h-full transition-all duration-300 ${document.documentElement.classList.contains('dark') ? 'bg-emerald-500' : 'bg-emerald-300'}`; }
            }

            updateCheckoutUI();
            if (window.tg && tg.HapticFeedback) tg.HapticFeedback.impactOccurred('light');
        }

        function updateCheckoutUI() {
            let totalQty = 0, totalPrice = 0;
            for (let [id, q] of Object.entries(cart)) {
                if (q > 0) {
                    let item = findItemInCatalog(id);
                    totalQty += q; 
                    totalPrice += q * (item ? parseFloat(item.price) : 0);
                }
            }

            const bar = document.getElementById('checkout-bar');
            const btnText = document.getElementById('checkout-text');
            const edited = Object.entries(cart).some(([id, q]) => (initialCartState[id] || 0) !== q);

            if (totalQty > 0) btnText.innerText = `${t('reviewOrder')} • €${totalPrice.toFixed(2)}`;
            else btnText.innerText = t('reviewOrder');

            if(bar) {
                (totalQty > 0 || edited) ? bar.classList.remove('translate-y-full') : bar.classList.add('translate-y-full');
            }
        }

