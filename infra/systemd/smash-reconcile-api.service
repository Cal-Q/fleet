[Unit]
Description=Smash Reconciliation REST API Server (Port 3500)
After=network.target

[Service]
Type=simple
User=smashbot
WorkingDirectory=/home/smashbot/smash-broadcaster
ExecStart=/home/smashbot/smash-agent/backend/.venv/bin/python3 /home/smashbot/smash-broadcaster/reconcile_api.py
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
