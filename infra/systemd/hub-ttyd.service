[Unit]
Description=Master Hub Web Terminal Daemon (ttyd)
After=network.target

[Service]
Type=simple
User=master
Group=master
WorkingDirectory=/opt/hub
ExecStart=/usr/bin/ttyd -p 7681 -i 127.0.0.1 -b /console/ttyd -W -a -P 10 -t fontSize=14 -t cursorBlink=true -t disableLeaveAlert=true -t scrollback=10000 /opt/hub/bin/session_runner.sh
Restart=always
RestartSec=2
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
