[Unit]
Description=Master Hub Central Console & Permanent Sessions API
After=network.target

[Service]
Type=simple
User=master
Group=master
WorkingDirectory=/opt/hub/web
Environment=PYTHONPATH=/opt/hub
Environment=HUB_PIN=superpato777
ExecStart=/usr/bin/python3 /opt/hub/web/app.py
Restart=always
RestartSec=3
KillMode=process
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
