[Unit]
Description=PTCG Server API (Dashboard and Sync)
After=network.target

[Service]
User=pokeuser
Group=pokeuser
WorkingDirectory=/opt/pokevault
EnvironmentFile=/opt/pokevault/.env
Environment="DATABASE_URL=/var/lib/pokevault/vault.db"
Environment="PATH=/opt/pokevault/venv/bin:/usr/local/bin:/usr/bin:/bin"

ExecStart=/opt/pokevault/venv/bin/gunicorn -w 2 -b 127.0.0.1:5000 --timeout 120 ptcg_server:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
