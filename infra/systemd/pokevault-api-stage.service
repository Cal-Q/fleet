[Unit]
Description=Gunicorn instance to serve PokeVault Staging API
After=network.target

[Service]
User=pokeuser
Group=pokeuser
WorkingDirectory=/opt/pokevault
EnvironmentFile=/opt/pokevault/.env
Environment="DATABASE_URL=/var/lib/pokevault/vault_stage.db"
Environment="CARDS_DATABASE_URL=/var/lib/pokevault/cards.db"
Environment="WEB_APP_URL=https://preview.pokepatrikvault.com"
Environment="PAYPAL_MODE=sandbox"
Environment="PATH=/opt/pokevault/venv/bin:/usr/local/bin:/usr/bin:/bin"

ExecStart=/opt/pokevault/venv/bin/gunicorn -w 2 -b 127.0.0.1:8001 --timeout 120 api:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
