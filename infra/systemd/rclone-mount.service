[Unit]
Description=RClone FUSE Mount for Google Drive Cold Storage
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/local/bin/rclone mount gdrive_backup:server-backups /mnt/gdrive_cold     --config=/etc/rclone/rclone.conf     --allow-other     --vfs-cache-mode=full     --vfs-cache-max-size=5G     --vfs-cache-max-age=24h     --dir-cache-time=24h     --poll-interval=1m     --vfs-read-chunk-size=16M     --vfs-read-chunk-size-limit=128M     --buffer-size=16M     --umask=022     --log-level=INFO     --log-file=/var/log/rclone-mount.log

ExecStop=/bin/fusermount3 -u -z /mnt/gdrive_cold
Restart=on-failure
RestartSec=10
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
