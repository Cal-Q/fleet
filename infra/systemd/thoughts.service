[Unit]
Description=Flying Thoughts & Considerations Flow Capture Web App
After=network.target

[Service]
Type=simple
User=thoughts
Group=thoughts
WorkingDirectory=/opt/thoughts
EnvironmentFile=/etc/default/thoughts
ExecStart=/usr/bin/gunicorn -w 2 -b 127.0.0.1:3040 app:app
Restart=always
RestartSec=3
LimitNOFILE=65536

# Sandboxing & Isolated Temp
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/thoughts/data

[Install]
WantedBy=multi-user.target
