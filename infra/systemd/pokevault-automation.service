[Unit]
Description=PokeVault Automation Script (Mail checker)
After=network.target

[Service]
User=pokeuser
Group=pokeuser
WorkingDirectory=/opt/pokevault
EnvironmentFile=/opt/pokevault/.env
Environment="DATABASE_URL=/var/lib/pokevault/vault.db"
Environment="DB_PATH=/var/lib/pokevault/vault.db"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/opt/pokevault/venv/bin/python /opt/pokevault/server_automation.py
Restart=always
RestartSec=60

[Install]
WantedBy=multi-user.target
