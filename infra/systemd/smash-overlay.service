[Unit]
Description=Smash Zen Playwright Live Overlay Daemon (Event-Gated Skia Engine)
After=network.target smash-backend.service

[Service]
Type=simple
User=smashbot
WorkingDirectory=/home/smashbot/smash-agent/backend
ExecStart=/home/smashbot/smash-agent/backend/.venv/bin/python3 /home/smashbot/smash-agent/backend/playwright_overlay_daemon.py
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=10
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
