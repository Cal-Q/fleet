[Unit]
Description=Gunicorn instance to serve PokeVault API
After=network.target

[Service]
# Using root ensures no "Permission Denied" errors while you are cleaning up
User=pokeuser
Group=pokeuser
WorkingDirectory=/opt/pokevault
EnvironmentFile=/opt/pokevault/.env
# Professional Database Paths
Environment="DATABASE_URL=/var/lib/pokevault/vault.db"
Environment="CARDS_DATABASE_URL=/var/lib/pokevault/cards.db"
Environment="PATH=/opt/pokevault/venv/bin:/usr/local/bin:/usr/bin:/bin"

# Points to the new lowercase path and runs the 'api.py' file
ExecStart=/opt/pokevault/venv/bin/gunicorn -w 4 -b 127.0.0.1:8000 --timeout 120 api:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
