#!/usr/bin/env bash
# run-agy-session: Inner persistent runner for Antigravity agents in tmux
# Single Responsibility: Execute agent loop with graceful exit/resume handling.
set -u

PROJECT="${1:-master}"
UID_NAME="${2:-$PROJECT}"
WORKSPACE="${3:-/opt/$PROJECT}"
EXTRA_ARGS="${4:--c}"
if [ "$EXTRA_ARGS" = "new" ] || [ "$EXTRA_ARGS" = "none" ]; then EXTRA_ARGS=""; fi

RELOAD_REQUESTED=0
reload_session() {
    RELOAD_REQUESTED=1
    echo -e "\n\033[1;36m🔄 OAuth account updated! Reloading conversation with new token...\033[0m"
    pkill -P $$ -f ssh 2>/dev/null || true
}
trap reload_session USR1

set_title() {
    local title="$1"
    printf "\033]0;%s\007\033]1;%s\007\033]2;%s\007" "$title" "$title" "$title" 2>/dev/null || true
}

set_title "🤖 AGY: ${PROJECT} (${UID_NAME})"

while true; do
    clear
    echo -e "\033[1;34m╔══════════════════════════════════════════════════════════════════╗\033[0m"
    echo -e "\033[1;34m║\033[0m  🚀 \033[1;32mAntigravity Persistent Agent Session\033[0m                       \033[1;34m║\033[0m"
    printf "\033[1;34m║\033[0m  Project: \033[1;36m%-16s\033[0m User: \033[1;33m%-12s\033[0m Host: \033[1;35mOracle VPS\033[0m  \033[1;34m║\033[0m\n" "$PROJECT" "$UID_NAME"
    printf "\033[1;34m║\033[0m  Target:  \033[0;37m%-48s\033[0m  \033[1;34m║\033[0m\n" "$WORKSPACE"
    printf "\033[1;34m║\033[0m  Args:    \033[0;37m%-48s\033[0m  \033[1;34m║\033[0m\n" "$EXTRA_ARGS"
    echo -e "\033[1;34m╚══════════════════════════════════════════════════════════════════╝\033[0m"
    echo ""

    ssh -t -o ServerAliveInterval=15 -o ServerAliveCountMax=4 -o TCPKeepAlive=yes -o StrictHostKeyChecking=no \
        ubuntu@84.8.254.222 "sudo /usr/local/bin/launch-oracle-agent \"$UID_NAME\" \"$WORKSPACE\" agy --dangerously-skip-permissions $EXTRA_ARGS"
    EXIT_CODE=$?

    # If reload was requested via SIGUSR1, immediately restart with -c
    if [ "$RELOAD_REQUESTED" -eq 1 ]; then
        RELOAD_REQUESTED=0
        EXTRA_ARGS="-c"
        sleep 0.5
        continue
    fi

    # Clean exit (/exit command or clean shutdown): exit runner to return to Agent Hub / caller
    if [ "$EXIT_CODE" -eq 0 ]; then
        break
    fi

    # On restart, always default to --continue (-c) to preserve conversation continuity
    EXTRA_ARGS="-c"

    echo ""
    echo -e "\033[1;33m────────────────────────────────────────────────────────────────────\033[0m"
    echo -e "\033[1;33m⚠️  Agent session closed (exit code: ${EXIT_CODE}).\033[0m"
    echo -e " [ \033[1;32mENTER\033[0m ] Resume chat (-c)  •  [ \033[1;36ms\033[0m ] Shell  •  [ \033[1;31mq\033[0m ] Exit window"
    echo -e "\033[1;33m────────────────────────────────────────────────────────────────────\033[0m"
    
    read -r -s -n 1 choice || choice="q"
    case "$choice" in
        s|S)
            echo "Opening project shell..."
            sudo -u "$UID_NAME" -i bash -c "cd '$WORKSPACE' && exec bash" || true
            ;;
        q|Q)
            echo "Exiting session."
            break
            ;;
        *)
            echo "Resuming conversation..."
            sleep 1
            ;;
    esac
done
